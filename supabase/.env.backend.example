# O Supabase fornece automaticamente:
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
#
# As configurações abaixo pertencem exclusivamente ao backend.
# Nunca use prefixo VITE_ para credenciais administrativas.

APP_ORIGIN=https://YOUR_ORGANIZATION.github.io
APP_URL=https://YOUR_ORGANIZATION.github.io/YOUR_REPOSITORY/

GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR_SHARED_DRIVE_FOLDER_ID

GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"YOUR_SERVICE_ACCOUNT_EMAIL","private_key":"YOUR_PRIVATE_KEY"}
