# O Supabase fornece automaticamente:
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
#
# As configurações abaixo pertencem exclusivamente ao backend.
# Nunca use prefixo VITE_ para credenciais administrativas.

APP_ORIGIN=https://YOUR_ORGANIZATION.github.io
APP_URL=https://YOUR_ORGANIZATION.github.io/YOUR_REPOSITORY/

GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR_MY_DRIVE_FOLDER_ID

# OAuth da conta Google pessoal dona da pasta. Guardar somente em secrets.
GOOGLE_OAUTH_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET
GOOGLE_OAUTH_REFRESH_TOKEN=YOUR_OAUTH_REFRESH_TOKEN
